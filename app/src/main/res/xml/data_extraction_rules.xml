<?xml version="1.0" encoding="utf-8"?>
<!--
    NV-03 U2: reglas de extracción/backup (API 31+).
    Se excluye el almacenamiento de DataStore (sesión/tokens) de cloud-backup,
    device-transfer y d2d para que ninguna credencial salga del dispositivo.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/" />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/" />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
    <d2d_transfer>
        <exclude domain="file" path="datastore/" />
        <exclude domain="sharedpref" path="." />
    </d2d_transfer>
</data-extraction-rules>
