<?xml version="1.0" encoding="utf-8"?>
<!--
    NV-03 U2: reglas de backup (API ≤ 30).
    Se excluye todo almacenamiento de preferencias (DataStore) porque puede
    contener datos de sesión/tokens cifrados de la cuenta del usuario.
-->
<full-backup-content>
    <exclude domain="file" path="datastore/" />
    <exclude domain="sharedpref" path="." />
</full-backup-content>
